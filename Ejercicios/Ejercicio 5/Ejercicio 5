#include <stdio.h>

int main() {
    int registros, nodos;
    printf("Ingrese el total de registros: ");
    scanf("%d", &registros);
    printf("Ingrese el numero de nodos: ");
    scanf("%d", &nodos);
    if (nodos > 0) {
        int por_nodo = registros / nodos;
        int sobrantes = registros % nodos;
        printf("Registros por nodo: %d\n", por_nodo);
        printf("Registros sin distribuir uniformemente: %d\n", sobrantes);
    } else {
        printf("El numero de nodos debe ser mayor a 0.\n");
    }
    return 0;
}