#include <stdio.h>

int main() {
    float horas, costo_hora, costo_total;
    printf("Ingrese las horas dedicadas al procesamiento: ");
    scanf("%f", &horas);
    printf("Ingrese el costo por hora: ");
    scanf("%f", &costo_hora);

    costo_total = horas * costo_hora;

    printf("\n--- RESUMEN DEL PROCESAMIENTO ---\n");
    printf("Horas trabajadas: %.2f hrs\n", horas);
    printf("Tarifa aplicada : $%.2f / hr\n", costo_hora);
    printf("Costo final     : $%.2f\n", costo_total);

    return 0;
}